{
  "name": "@bdkha/document-kit",
  "version": "0.1.0",
  "description": "Bộ kit lưu trữ tài liệu dùng chung cho AI workflow giữa FE và BE (git + MCP, local-first)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "documentation",
    "ai",
    "mcp",
    "openapi",
    "spec-driven",
    "frontend",
    "backend"
  ],
  "author": "bdkha <buidinhkha81@gmail.com>",
  "homepage": "https://github.com/bdkha/document-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bdkha/document-kit.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "doc-kit": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "scaffold/",
    ".doc-kit/schema/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev:mcp": "tsx src/mcp/index.ts",
    "cli": "tsx src/cli/index.ts",
    "validate": "tsx src/cli/index.ts validate",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.6.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
