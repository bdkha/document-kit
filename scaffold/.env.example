# Document Kit — cấu hình per-project. Copy thành .env (đã gitignore).
# Thứ tự ưu tiên: CLI flag > .env > .doc-kit/config.yaml > default.

# Gốc content docs. Thường không cần set nếu chạy lệnh từ trong repo docs này
# (tool tự dò ngược tìm .doc-kit/config.yaml). Set khi MCP chạy từ thư mục khác.
# DOC_KIT_ROOT=/duong/dan/toi/repo-docs

# Tên consumer (FE web / FE mobile / BE…) — dùng trong state pull & thông báo.
DOC_KIT_CONSUMER=fe-web

# Vai consumer: fe (repo FE) | be (repo BE). Quyết định pending/plan trả delta của vai nào.
DOC_KIT_ROLE=fe

# Vị trí file state pull của consumer này (mặc định <root>/.doc-kit-state.local.json).
# DOC_KIT_STATE=.doc-kit-state.local.json

# PUSH notify qua Linear (tuỳ chọn). Để trống = bỏ qua notify.
# LINEAR_API_KEY=lin_api_xxx

# Org slug Linear (dùng dựng URL ticket nếu cần).
# LINEAR_ORG=your-org

# PUSH notify qua Redmine (tuỳ chọn). Redmine thường self-host nên cần base URL.
# REDMINE_URL là gốc instance Redmine (vd https://redmine.cong-ty.vn).
# REDMINE_API_KEY là API key cá nhân (My account → API access key).
# REDMINE_URL=https://redmine.cong-ty.vn
# REDMINE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Đọc link Notion qua `doc-kit add-raw` (tuỳ chọn). Token integration Notion,
# và trang phải được share cho integration đó.
# NOTION_API_KEY=secret_xxx
# NOTION_VERSION=2022-06-28
